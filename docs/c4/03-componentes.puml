@startuml
left to right direction
skinparam shadowing false
rectangle "Android / Retrofit\nApiService" as android
package "API Spring Boot" {
 rectangle "SecurityConfig +\nTokenAuthenticationFilter\n<<Component>>" as security
 rectangle "AuthController\n<<Component>>" as authController
 rectangle "AuthService\n<<Component>>" as authService
 rectangle "ProfileController\n<<Component>>" as profile
 rectangle "SubjectController\n<<Component>>" as subjects
 rectangle "TaskController\n<<Component>>" as tasks
 rectangle "ChallengeController\n<<Component>>" as challenges
 rectangle "Spring JdbcClient\n<<Infraestructura>>" as jdbc
}
database "PostgreSQL 16" as db
android --> security : HTTP + Bearer
security --> authController
security --> profile
security --> subjects
security --> tasks
security --> challenges
authController --> authService : register/login/me/logout
authService --> jdbc : sql(...)
profile --> jdbc : sql(...)
subjects --> jdbc : sql(...)
tasks --> jdbc : sql(...)
challenges --> jdbc : sql(...)
jdbc --> db : JDBC / SQL
@enduml
